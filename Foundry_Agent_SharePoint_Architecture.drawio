        <mxCell id="benefits-text" parent="1" style="text;html=1;fontSize=10;fontColor=#0078D4;fontStyle=1;align=left;verticalAlign=top;spacing=8;spacingTop=8;" value="✓ No data duplication — indexes SharePoint in-place&lt;br&gt;✓ Respects SharePoint permissions (security trimming)&lt;br&gt;✓ Automatic incremental sync (change detection)&lt;br&gt;✓ Agentic retrieval with query decomposition &amp; reranking" vertex="1">
          <mxGeometry height="90" width="470" x="1165" y="925" as="geometry" />
        </mxCell>
